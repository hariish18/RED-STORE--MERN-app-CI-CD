PORT=your_port_here
# Standard format: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dbname
# If you get a "querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net" error (SRV DNS resolution
# blocked by your network/local DNS), use the standard connection format with explicit hosts instead
# (mongodb://host1,host2,host3/dbname?replicaSet=...&ssl=true), available on Atlas via
# "Connect" → "Drivers" → "Advanced connection options"
MONGODB_URI=your_mongodb_uri_here
SECRET_KEY=your_jwt_secret_here
CLOUD_NAME=your_cloudinary_cloud_name_here
API_KEY=your_cloudinary_api_key_here
API_SECRET=your_cloudinary_api_secret_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: base URL for password-reset links (default http://localhost:5173)
FRONTEND_URL=
# Optional: number of proxies in front of the API (default 1 = Nginx; 2 if one more proxy, e.g. Render)
TRUST_PROXY=
