# Variables read by docker-compose.yml (copy to .env at the root).
# PUBLIC values ONLY: they end up in the frontend JS bundle.
VITE_STRIPE_PUBLISHABLE_KEY=
# Leave empty: the frontend calls /api relative to its own origin, proxied by Nginx
VITE_API_URL=
# Optional: base URL for password-reset links (default http://localhost:8080)
FRONTEND_URL=
